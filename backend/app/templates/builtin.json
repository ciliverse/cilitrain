[
  {
    "id": "custom",
    "name": "Custom",
    "kind": "custom",
    "description": "Paste Python, submit a Job / 贴脚本提交训练 Job",
    "script": "custom/train.py",
    "image": "python:3.12-slim",
    "cpu": "1",
    "memory": "1Gi",
    "timeout_seconds": 1800
  },
  {
    "id": "nanogpt-cpu",
    "name": "nanoGPT CPU",
    "kind": "train",
    "description": "Tiny character GPT (~0.8M params) on CPU / 微型字符级 GPT，走通训练曲线与产物",
    "script": "nanogpt-cpu/train.py",
    "script_bootstrap": "torch-cpu",
    "image": "python:3.12-slim",
    "cpu": "4",
    "memory": "8Gi",
    "timeout_seconds": 7200,
    "gpu_count": 0,
    "params": [
      {"key": "epochs", "type": "int", "min": 1, "max": 50, "default": 8},
      {"key": "steps_per_epoch", "type": "int", "min": 5, "max": 500, "default": 40},
      {"key": "learning_rate", "type": "float", "min": 0.00001, "max": 0.01, "default": 0.0003},
      {"key": "batch_size", "type": "int", "min": 1, "max": 128, "default": 16}
    ],
    "resume_files": ["model.pt"],
    "infer": {
      "script": "nanogpt-cpu/infer.py",
      "bootstrap": "torch-cpu",
      "model_files": ["model.pt"],
      "output": "text",
      "batch_max_rows": 20,
      "cpu": "1",
      "memory": "2Gi",
      "timeout_seconds": 900,
      "fields": [
        {"key": "prompt", "type": "text", "default": "To be, or not", "max_len": 400},
        {"key": "max_new_tokens", "type": "int", "min": 1, "max": 500, "default": 200},
        {"key": "temperature", "type": "float", "min": 0.1, "max": 2.0, "default": 0.8}
      ]
    }
  },
  {
    "id": "sklearn-cpu",
    "name": "sklearn CPU demo",
    "kind": "train",
    "description": "Tiny scikit-learn fit + metrics.json / 小型训练并写出指标",
    "script": "sklearn-cpu/train.py",
    "script_bootstrap": "sklearn",
    "image": "python:3.12-slim",
    "cpu": "1",
    "memory": "1Gi",
    "timeout_seconds": 3600,
    "params": [
      {"key": "c", "type": "float", "min": 0.001, "max": 100, "default": 1.0},
      {"key": "max_iter", "type": "int", "min": 10, "max": 2000, "default": 200},
      {"key": "test_size", "type": "float", "min": 0.1, "max": 0.5, "default": 0.25}
    ],
    "infer": {
      "script": "sklearn-cpu/infer.py",
      "bootstrap": "sklearn",
      "model_files": ["model.joblib"],
      "output": "classification",
      "batch_max_rows": 1000,
      "cpu": "500m",
      "memory": "512Mi",
      "timeout_seconds": 600,
      "fields": [
        {"key": "sepal_length", "type": "float", "min": 0, "max": 10, "default": 5.8},
        {"key": "sepal_width", "type": "float", "min": 0, "max": 10, "default": 3.0},
        {"key": "petal_length", "type": "float", "min": 0, "max": 10, "default": 4.3},
        {"key": "petal_width", "type": "float", "min": 0, "max": 10, "default": 1.3}
      ]
    }
  },
  {
    "id": "monitor-demo",
    "name": "Monitor demo",
    "kind": "chart-demo",
    "description": "Fake epoch metrics for charts / 模拟 epoch 指标便于监控展示",
    "script": "monitor-demo/train.py",
    "params": [
      {"key": "epochs", "type": "int", "min": 1, "max": 30, "default": 7}
    ],
    "image": "python:3.12-slim",
    "cpu": "200m",
    "memory": "256Mi",
    "timeout_seconds": 600
  },
  {
    "id": "preprocess-demo",
    "name": "Preprocess demo",
    "kind": "pipeline",
    "description": "Pipeline step 1: write dataset stub / 流水线预处理示例",
    "image": "python:3.12-slim",
    "command": ["bash", "-lc"],
    "args": [
      "python -u -c \"import os; from pathlib import Path; p=Path(os.environ.get('CILITRAIN_OUTPUT','/output')); p.mkdir(parents=True, exist_ok=True); (p/'dataset.txt').write_text('x,y\\n1,0\\n2,1\\n'); (p/'metrics.json').write_text('{\\\"rows\\\":2,\\\"step\\\":\\\"preprocess\\\"}'); print('metrics rows=2 step=1'); print('[cilitrain] preprocess done →', p)\""
    ],
    "cpu": "200m",
    "memory": "256Mi",
    "timeout_seconds": 600,
    "gpu_count": 0
  },
  {
    "id": "gpu-smoke",
    "name": "GPU smoke (nvidia-smi)",
    "kind": "gpu-smoke",
    "description": "Needs NVIDIA + device plugin; prints nvidia-smi / 需 GPU 集群，打印 nvidia-smi",
    "image": "nvidia/cuda:12.4.1-base-ubuntu22.04",
    "command": ["bash", "-lc"],
    "args": [
      "set -euo pipefail; echo '[cilitrain] GPU smoke'; nvidia-smi; mkdir -p \"${CILITRAIN_OUTPUT:-/output}\"; nvidia-smi > \"${CILITRAIN_OUTPUT:-/output}/nvidia-smi.txt\"; echo '{\"gpu_smoke\":true}' > \"${CILITRAIN_OUTPUT:-/output}/metrics.json\"; echo '[cilitrain] done'"
    ],
    "cpu": "500m",
    "memory": "1Gi",
    "timeout_seconds": 600,
    "gpu_count": 1
  }
]
